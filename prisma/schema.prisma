generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String?        @unique
  phone            String?        @unique
  passwordHash     String?
  name             String
  role             UserRole       @default(PATIENT)
  status           UserStatus     @default(ACTIVE)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  auditLogs        AuditLog[]     @relation("ActorAuditLogs")
  doctorProfile    Doctor?
  otpChallenges    OtpChallenge[]
  patientProfile   Patient?
  refreshTokens    RefreshToken[]

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpChallenge {
  id         String              @id @default(uuid())
  userId     String
  channel    NotificationChannel @default(EMAIL)
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     AuditAction
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  requestId  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Patient {
  id                String             @id @default(uuid())
  userId            String             @unique
  mrn               String             @unique
  dob               DateTime
  gender            Gender             @default(UNKNOWN)
  bloodGroup        String?
  address           String?
  secondaryPhone    String?
  secondaryEmail    String?
  preferredLanguage String?            @default("en")
  isMerged          Boolean            @default(false)
  mergedIntoId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  admissions        Admission[]
  allergies         Allergy[]
  appointments      Appointment[]
  diagnosticOrders  DiagnosticOrder[]
  emergencyContacts EmergencyContact[]
  encounters        Encounter[]
  invoices          Invoice[]
  medicalHistories  MedicalHistory[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts            PatientAlert[]
  documents         PatientDocument[]
  prescriptions     Prescription[]
  queueTokens       QueueToken[]
  vitalSigns        VitalSign[]

  @@index([mrn])
  @@index([dob])
  @@index([deletedAt])
}

model EmergencyContact {
  id           String   @id @default(uuid())
  patientId    String
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientAlert {
  id             String    @id @default(uuid())
  patientId      String
  type           String
  note           String
  isActive       Boolean   @default(true)
  resolvedReason String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, isActive])
}

model PatientDocument {
  id         String    @id @default(uuid())
  patientId  String
  type       String
  title      String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedBy String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Department {
  id           String        @id @default(uuid())
  name         String        @unique
  code         String        @unique
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  doctors      Doctor[]
}

model Doctor {
  id              String          @id @default(uuid())
  userId          String          @unique
  departmentId    String
  specialization  String
  qualifications  String?
  licenseNumber   String?
  consultationFee Decimal         @default(120.00) @db.Decimal(10, 2)
  roomNumber      String?
  bio             String?
  photoUrl        String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  admissions      Admission[]     @relation("AdmittingDoctor")
  appointments    Appointment[]
  clinicSessions  ClinicSession[]
  department      Department      @relation(fields: [departmentId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves          DoctorLeave[]
  encounters      Encounter[]
  prescriptions   Prescription[]
  queueTokens     QueueToken[]

  @@index([departmentId, isActive])
}

model ClinicSession {
  id                  String   @id @default(uuid())
  doctorId            String
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int      @default(15)
  maxCapacity         Int      @default(30)
  roomNumber          String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startDate, endDate])
}

model Appointment {
  id                 String            @id @default(uuid())
  appointmentNumber  String            @unique
  patientId          String
  doctorId           String
  departmentId       String
  appointmentType    AppointmentType   @default(NEW)
  slotStart          DateTime
  slotEnd            DateTime
  status             AppointmentStatus @default(CONFIRMED)
  cancellationReason String?
  rescheduledToId    String?
  notes              String?
  createdBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  department         Department        @relation(fields: [departmentId], references: [id])
  doctor             Doctor            @relation(fields: [doctorId], references: [id])
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter          Encounter?
  queueToken         QueueToken?

  @@unique([doctorId, slotStart, status])
  @@index([patientId, slotStart])
  @@index([doctorId, slotStart])
  @@index([status])
}

model WaitlistEntry {
  id            String   @id @default(uuid())
  patientId     String
  doctorId      String
  preferredDate DateTime
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([doctorId, preferredDate])
}

model QueueToken {
  id                    String           @id @default(uuid())
  tokenNumber           String
  doctorId              String
  patientId             String
  appointmentId         String?          @unique
  source                QueueSource      @default(APPOINTMENT)
  priorityTier          PriorityTier     @default(NORMAL)
  status                QueueTokenStatus @default(WAITING)
  position              Int              @default(1)
  estimatedWaitMinutes  Int              @default(15)
  checkedInAt           DateTime         @default(now())
  calledAt              DateTime?
  completedAt           DateTime?
  transferredToDoctorId String?
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  encounters            Encounter[]
  events                QueueEvent[]
  appointment           Appointment?     @relation(fields: [appointmentId], references: [id])
  doctor                Doctor           @relation(fields: [doctorId], references: [id])
  patient               Patient          @relation(fields: [patientId], references: [id])

  @@index([doctorId, status])
  @@index([checkedInAt])
  @@index([patientId])
}

model QueueEvent {
  id        String     @id @default(uuid())
  tokenId   String
  eventType String
  payload   Json?
  createdAt DateTime   @default(now())
  token     QueueToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
}

model Encounter {
  id               String            @id @default(uuid())
  encounterNumber  String            @unique
  patientId        String
  doctorId         String
  appointmentId    String?           @unique
  tokenId          String?
  status           EncounterStatus   @default(IN_PROGRESS)
  chiefComplaint   String?
  subjectiveNotes  String?
  objectiveNotes   String?
  assessmentNotes  String?
  planNotes        String?
  signedAt         DateTime?
  signedBy         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  diagnoses        Diagnosis[]
  diagnosticOrders DiagnosticOrder[]
  appointment      Appointment?      @relation(fields: [appointmentId], references: [id])
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queueToken       QueueToken?       @relation(fields: [tokenId], references: [id])
  invoices         Invoice[]
  prescriptions    Prescription[]
  vitalSigns       VitalSign[]

  @@index([patientId, createdAt])
  @@index([doctorId, status])
}

model VitalSign {
  id                 String     @id @default(uuid())
  encounterId        String?
  patientId          String
  recordedBy         String?
  systolicBp         Int?
  diastolicBp        Int?
  heartRate          Int?
  respiratoryRate    Int?
  temperatureCelsius Decimal?   @db.Decimal(4, 1)
  oxygenSaturation   Int?
  fastingGlucose     Int?
  heightCm           Decimal?   @db.Decimal(5, 2)
  weightKg           Decimal?   @db.Decimal(5, 2)
  bmi                Decimal?   @db.Decimal(4, 1)
  recordedAt         DateTime   @default(now())
  encounter          Encounter? @relation(fields: [encounterId], references: [id])
  patient            Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, recordedAt])
}

model Diagnosis {
  id          String    @id @default(uuid())
  encounterId String
  icdCode     String
  description String
  type        String    @default("PRIMARY")
  createdAt   DateTime  @default(now())
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
}

model Allergy {
  id         String   @id @default(uuid())
  patientId  String
  allergen   String
  reaction   String?
  severity   String   @default("MODERATE")
  recordedAt DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model MedicalHistory {
  id            String   @id @default(uuid())
  patientId     String
  condition     String
  diagnosedYear Int?
  notes         String?
  createdAt     DateTime @default(now())
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Medicine {
  id                String             @id @default(uuid())
  name              String
  genericName       String
  manufacturer      String?
  form              MedicineForm       @default(TABLET)
  strength          String?
  unit              String             @default("Tablet")
  unitPrice         Decimal            @default(1.50) @db.Decimal(10, 2)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dispensationItems DispensationItem[]
  inventoryItems    InventoryItem[]
  prescriptionItems PrescriptionItem[]

  @@index([name])
  @@index([genericName])
}

model Prescription {
  id                 String             @id @default(uuid())
  prescriptionNumber String             @unique
  encounterId        String
  patientId          String
  doctorId           String
  status             PrescriptionStatus @default(PENDING)
  pharmacistNotes    String?
  holdReason         String?
  validatedBy        String?
  validatedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  dispensations      Dispensation[]
  doctor             Doctor             @relation(fields: [doctorId], references: [id])
  encounter          Encounter          @relation(fields: [encounterId], references: [id])
  patient            Patient            @relation(fields: [patientId], references: [id])
  items              PrescriptionItem[]

  @@index([patientId])
  @@index([status])
}

model PrescriptionItem {
  id                 String             @id @default(uuid())
  prescriptionId     String
  medicineId         String
  dosage             String
  frequency          String
  durationDays       Int                @default(30)
  quantityPrescribed Int                @default(30)
  quantityDispensed  Int                @default(0)
  instructions       String?
  dispensationItems  DispensationItem[]
  medicine           Medicine           @relation(fields: [medicineId], references: [id])
  prescription       Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model Dispensation {
  id             String             @id @default(uuid())
  prescriptionId String
  dispensedBy    String
  dispensedAt    DateTime           @default(now())
  totalAmount    Decimal            @db.Decimal(10, 2)
  status         String             @default("COMPLETED")
  prescription   Prescription       @relation(fields: [prescriptionId], references: [id])
  items          DispensationItem[]

  @@index([prescriptionId])
}

model DispensationItem {
  id                 String           @id @default(uuid())
  dispensationId     String
  prescriptionItemId String
  medicineId         String
  batchId            String?
  quantityDispensed  Int
  unitPrice          Decimal          @db.Decimal(10, 2)
  dispensation       Dispensation     @relation(fields: [dispensationId], references: [id], onDelete: Cascade)
  medicine           Medicine         @relation(fields: [medicineId], references: [id])
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])

  @@index([dispensationId])
}

model StockLocation {
  id        String             @id @default(uuid())
  name      String             @unique
  type      StockLocationType  @default(PHARMACY)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  batches   StockBatch[]
  ledger    StockLedgerEntry[]
}

model InventoryItem {
  id                 String             @id @default(uuid())
  medicineId         String?
  name               String
  category           InventoryCategory  @default(MEDICINE)
  unit               String             @default("Box")
  reorderThreshold   Int                @default(100)
  currentStockOnHand Int                @default(0)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  medicine           Medicine?          @relation(fields: [medicineId], references: [id])
  batches            StockBatch[]
  ledger             StockLedgerEntry[]

  @@index([category])
  @@index([name])
}

model StockBatch {
  id                String             @id @default(uuid())
  itemId            String
  locationId        String
  lotNumber         String
  manufacturingDate DateTime?
  expiryDate        DateTime
  quantityAvailable Int                @default(0)
  unitCost          Decimal            @default(0.80) @db.Decimal(10, 2)
  status            BatchStatus        @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  item              InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location          StockLocation      @relation(fields: [locationId], references: [id])
  ledger            StockLedgerEntry[]

  @@index([itemId, status])
  @@index([expiryDate])
}

model StockLedgerEntry {
  id            String              @id @default(uuid())
  itemId        String
  batchId       String?
  locationId    String
  quantityDelta Int
  reason        StockMovementReason
  refType       String?
  refId         String?
  createdBy     String?
  createdAt     DateTime            @default(now())
  batch         StockBatch?         @relation(fields: [batchId], references: [id])
  item          InventoryItem       @relation(fields: [itemId], references: [id])
  location      StockLocation       @relation(fields: [locationId], references: [id])

  @@index([itemId, createdAt])
  @@index([locationId])
  @@index([batchId])
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique
  supplierId  String
  status      String              @default("DRAFT")
  totalAmount Decimal             @default(0.00) @db.Decimal(10, 2)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  itemName        String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model DiagnosticCatalog {
  id             String                @id @default(uuid())
  name           String
  code           String                @unique
  category       DiagnosticCategory    @default(LABORATORY)
  sampleType     String?
  referenceRange String?
  price          Decimal               @default(65.00) @db.Decimal(10, 2)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  orderItems     DiagnosticOrderItem[]
  results        DiagnosticResult[]
}

model DiagnosticOrder {
  id          String                @id @default(uuid())
  orderNumber String                @unique
  encounterId String?
  patientId   String
  doctorId    String?
  status      DiagnosticOrderStatus @default(ORDERED)
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  encounter   Encounter?            @relation(fields: [encounterId], references: [id])
  patient     Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items       DiagnosticOrderItem[]
  results     DiagnosticResult[]

  @@index([patientId])
  @@index([status])
}

model DiagnosticOrderItem {
  id      String            @id @default(uuid())
  orderId String
  testId  String
  price   Decimal           @db.Decimal(10, 2)
  order   DiagnosticOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test    DiagnosticCatalog @relation(fields: [testId], references: [id])

  @@index([orderId])
}

model DiagnosticResult {
  id             String            @id @default(uuid())
  orderId        String
  testId         String
  numericValue   Decimal?          @db.Decimal(10, 2)
  textValue      String?
  referenceRange String?
  isAbnormal     Boolean           @default(false)
  reportFileUrl  String?
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime          @default(now())
  order          DiagnosticOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test           DiagnosticCatalog @relation(fields: [testId], references: [id])

  @@index([orderId])
}

model Tariff {
  id          String   @id @default(uuid())
  serviceType String
  serviceName String
  amount      Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Invoice {
  id             String           @id @default(uuid())
  invoiceNumber  String           @unique
  patientId      String
  encounterId    String?
  totalAmount    Decimal          @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal          @default(0.00) @db.Decimal(10, 2)
  taxAmount      Decimal          @default(0.00) @db.Decimal(10, 2)
  netAmount      Decimal          @default(0.00) @db.Decimal(10, 2)
  paidAmount     Decimal          @default(0.00) @db.Decimal(10, 2)
  balanceAmount  Decimal          @default(0.00) @db.Decimal(10, 2)
  status         InvoiceStatus    @default(ISSUED)
  dueDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  claims         InsuranceClaim[]
  encounter      Encounter?       @relation(fields: [encounterId], references: [id])
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items          InvoiceItem[]
  payments       Payment[]

  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id           String  @id @default(uuid())
  invoiceId    String
  description  String
  quantity     Int     @default(1)
  unitPrice    Decimal @db.Decimal(10, 2)
  totalPrice   Decimal @db.Decimal(10, 2)
  sourceModule String?
  sourceRefId  String?
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                   String        @id @default(uuid())
  invoiceId            String
  patientId            String
  amount               Decimal       @db.Decimal(10, 2)
  paymentMethod        PaymentMethod @default(CARD)
  transactionReference String?
  collectedBy          String?
  createdAt            DateTime      @default(now())
  invoice              Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model InsuranceClaim {
  id             String               @id @default(uuid())
  invoiceId      String
  patientId      String
  providerName   String
  policyNumber   String
  authNumber     String?
  claimAmount    Decimal              @db.Decimal(10, 2)
  approvedAmount Decimal?             @db.Decimal(10, 2)
  status         InsuranceClaimStatus @default(SUBMITTED)
  submittedAt    DateTime             @default(now())
  resolvedAt     DateTime?
  invoice        Invoice              @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Ward {
  id        String   @id @default(uuid())
  name      String   @unique
  type      WardType @default(MALE_GENERAL)
  totalBeds Int      @default(20)
  createdAt DateTime @default(now())
  beds      Bed[]
}

model Bed {
  id         String      @id @default(uuid())
  wardId     String
  bedNumber  String
  status     BedStatus   @default(AVAILABLE)
  dailyRate  Decimal     @default(250.00) @db.Decimal(10, 2)
  createdAt  DateTime    @default(now())
  admissions Admission[]
  ward       Ward        @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, bedNumber])
  @@index([status])
}

model Admission {
  id                 String          @id @default(uuid())
  admissionNumber    String          @unique
  patientId          String
  admittingDoctorId  String
  bedId              String
  admissionDate      DateTime        @default(now())
  dischargeDate      DateTime?
  admissionDiagnosis String?
  dischargeSummary   String?
  status             AdmissionStatus @default(ADMITTED)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  admittingDoctor    Doctor          @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id])
  bed                Bed             @relation(fields: [bedId], references: [id])
  patient            Patient         @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([bedId])
  @@index([status])
}

model NotificationLog {
  id          String              @id @default(uuid())
  recipientId String
  channel     NotificationChannel @default(IN_APP)
  title       String
  message     String
  status      NotificationStatus  @default(SENT)
  createdAt   DateTime            @default(now())

  @@index([recipientId, status])
}

enum UserRole {
  PATIENT
  RECEPTIONIST
  DOCTOR
  NURSE
  PHARMACIST
  LAB_TECH
  RADIOLOGIST
  INVENTORY_MANAGER
  BILLING_STAFF
  ADMIN
  MANAGEMENT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
  PENDING_VERIFICATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum AppointmentType {
  NEW
  FOLLOW_UP
  EMERGENCY
  WALK_IN
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PriorityTier {
  NORMAL
  PRIORITY
  EMERGENCY
}

enum QueueTokenStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  NO_RESPONSE
  CANCELLED
  TRANSFERRED
}

enum QueueSource {
  APPOINTMENT
  WALK_IN
}

enum EncounterStatus {
