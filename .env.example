# ==========================================================
# Going Merry Hospital Management System — Environment Configuration
# ==========================================================

# 1. Database (PostgreSQL / Neon DB / Azure Database for PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-sample-neon-db.us-east-2.aws.neon.tech/going_merry_hms?sslmode=require"

# 2. JWT Authentication Secrets (IAM-01)
JWT_SECRET="super-secret-access-token-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 3. Upstash Redis (Distributed Caching & Concurrency Locks)
UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample_upstash_redis_token"

# 4. Upstash QStash (Asynchronous Queues, Background Events & Retries)
QSTASH_URL="https://qstash.upstash.io/v2/publish"
QSTASH_TOKEN="sample_qstash_token"

# 5. OpenRouter AI (Clinical Decision Support Advisory)
OPENROUTER_API_KEY="sk-or-v1-sample-openrouter-key"
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# 6. Cloudinary (Clinical Documents, Lab Reports, Medical Scans)
CLOUDINARY_CLOUD_NAME="going-merry-hms"
CLOUDINARY_API_KEY="sample_cloudinary_key"
CLOUDINARY_API_SECRET="sample_cloudinary_secret"
CLOUDINARY_URL="cloudinary://sample_key:sample_secret@going-merry-hms"

# 7. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
